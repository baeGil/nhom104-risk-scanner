# =============================================================================
# Environment Variables Template — Vietnamese Legal Knowledge Graph
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_HEAP_INITIAL_SIZE=512M
NEO4J_HEAP_SIZE=2G
NEO4J_PAGE_CACHE=1G

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ── Intent Thresholds ────────────────────────────────────────────────────────
# INTENT_Ran command: `clear`

# Câu lệnh này chính là **"Nút khởi động"** toàn bộ cỗ máy dữ liệu mà Người A đã xây dựng. Nó có ảnh hưởng trực tiếp và rất quan trọng đến công việc của bạn (Người B).

# Dưới đây là giải thích chi tiết:

# ### 1. `set -a && source .env && set +a` là gì?
# Đây là một "mẹo" trong dòng lệnh (Terminal) để **nạp biến môi trường**:
# *   File `.env` chứa những thông tin nhạy cảm như mật khẩu Neo4j (`NEO4J_PASSWORD`), địa chỉ server.
# *   Câu lệnh này giúp máy tính hiểu và ghi nhớ các thông tin đó để khi chạy Python, code có thể kết nối được vào Database mà không cần bạn phải gõ mật khẩu trực tiếp vào code (việc này rất mất an toàn).

# ### 2. `python -m src.data_pipeline.pipeline` là gì?
# Đây là lệnh yêu cầu Python chạy file **Nhạc trưởng (Pipeline)** của Người A. Nó sẽ thực hiện một chuỗi các hành động:
# *   Chuẩn hóa số hiệu văn bản.
# *   Cào dữ liệu thiếu.
# *   Làm sạch HTML.
# *   **Tạo ra các Node Document trên Neo4j.**

# ---

# ### 3. Nó có ảnh hưởng gì tới việc bạn đang làm không?
# **CÓ, ảnh hưởng rất lớn!** Hãy coi đây là bước "Dọn sân" trước khi bạn vào đá bóng:

# *   **Nếu bạn KHÔNG chạy cái này**:
#     *   Bạn sẽ không có dữ liệu sạch (`content_clean.parquet`) để parse Điều/Khoản.
#     *   Bạn sẽ không có bảng tra cứu (`so_ky_hieu_lookup.json`) để làm phần Dẫn chiếu ngoại.
#     *   Quan trọng nhất: Khi bạn trích xuất được một liên kết (ví dụ: *"Sửa đổi Điều 5 Nghị định 46"*), bạn định lưu vào Neo4j nhưng **Neo4j lúc đó đang trống rỗng**, không có Nghị định 46 nào cả. Liên kết của bạn sẽ bị "treo", không nối vào đâu được.

# *   **Nếu bạn CHẠY cái này**:
#     *   Nó sẽ tạo ra tất cả các "Điểm đến" (Target) trong Neo4j.
#     *   Công việc của bạn lúc này chỉ là: Trích xuất quan hệ và **"cắm"** chúng vào các Node mà Người A đã tạo sẵn.

# ### 💡 Lời khuyên:
# Bạn nên chạy lệnh này **ít nhất một lần** (hoặc để nó chạy ngầm) trước khi bạn bắt đầu chạy Pipeline trích xuất quan hệ của mình. Khi sân đấu (Neo4j) đã đầy đủ các văn bản, việc bạn tạo các đường chuyền (Dẫn chiếu) giữa chúng sẽ diễn ra cực kỳ mượt mà.

# Bạn có muốn tôi kiểm tra giúp bạn xem file `.env` của bạn đã điền đúng thông tin chưa để chuẩn bị chạy lệnh này không?_
CONFIDENCE_THRESHOLD=0.7
INTENT_CLARIFICATION_THRESHOLD=0.4

# ── Embedding Service ────────────────────────────────────────────────────────
EMBED_SERVICE_URL=http://localhost:8001
EMBED_MODEL=mainguyen9/vietlegal-harrier-0.6b
EMBED_BATCH_SIZE=512
EMBED_MAX_TEXTS=1000
EMBED_DIMENSIONS=1024
EMBED_HOST=0.0.0.0
EMBED_PORT=8001

# ── Data Paths ───────────────────────────────────────────────────────────────
DATA_DIR=data
OUTPUT_DIR=output
METADATA_PATH=data/metadata.parquet
CONTENT_PATH=data/content.parquet
RELATIONSHIPS_PATH=data/relationships.parquet
METADATA_DEDUPED_PATH=data/metadata_deduped.parquet
CONTENT_ENRICHED_PATH=data/content_enriched.parquet
CONTENT_CLEAN_PATH=data/content_clean.parquet
LOOKUP_PATH=output/so_ky_hieu_lookup.json
SCHEMA_PATH=output/neo4j_schema.cypher
PIPELINE_CHECKPOINT=output/pipeline_checkpoint.json

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_PATH=output/pipeline.log
NEO4J_BATCH_SIZE=5000
PARQUET_BATCH_SIZE=2000
CRAWL_RATE_LIMIT=1.5
CRAWL_TIMEOUT=15
CRAWL_MAX_RETRIES=3
CRAWL_CHECKPOINT=output/crawl_checkpoint.json
VECTOR_INDEX_NAME=article_embeddings

# ── Contract Parser ──────────────────────────────────────────────────────────
CONTRACT_PARSER_BACKEND=pipeline
CONTRACT_PARSER_LANG=ch

