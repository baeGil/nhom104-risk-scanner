# =============================================================================
# Environment Variables Template — PhápLý (Vietnamese Legal Knowledge Graph)
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── Auth & Database (Auth.js v5 + Supabase) ─────────────────────────────────
# Supabase Postgres connection string (Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Supabase anon public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJxxxxx

# OAuth & Email
AUTH_SECRET=<generate with: openssl rand -base64 32>
AUTH_GOOGLE_ID=xxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxx
AUTH_GITHUB_ID=Iv1.xxxxx
AUTH_GITHUB_SECRET=xxxxx
AUTH_RESEND_KEY=re_xxxxx
AUTH_FROM_EMAIL=onboarding@resend.dev

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password
NEO4J_HEAP_INITIAL_SIZE=512M
NEO4J_HEAP_SIZE=2G
NEO4J_PAGE_CACHE=1G

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ── Intent Thresholds ────────────────────────────────────────────────────────
INTENT_CONFIDENCE_THRESHOLD=0.7
INTENT_CLARIFICATION_THRESHOLD=0.4

# ── Embedding Service ────────────────────────────────────────────────────────
EMBED_SERVICE_URL=http://localhost:8001
EMBED_MODEL=mainguyen9/vietlegal-harrier-0.6b
EMBED_BATCH_SIZE=512
EMBED_MAX_TEXTS=1000
EMBED_DIMENSIONS=1024
EMBED_HOST=0.0.0.0
EMBED_PORT=8001

# ── Data Paths ───────────────────────────────────────────────────────────────
DATA_DIR=data
OUTPUT_DIR=output
METADATA_PATH=data/metadata.parquet
CONTENT_PATH=data/content.parquet
RELATIONSHIPS_PATH=data/relationships.parquet
METADATA_DEDUPED_PATH=data/metadata_deduped.parquet
CONTENT_ENRICHED_PATH=data/content_enriched.parquet
CONTENT_CLEAN_PATH=data/content_clean.parquet
LOOKUP_PATH=output/so_ky_hieu_lookup.json
SCHEMA_PATH=output/neo4j_schema.cypher
PIPELINE_CHECKPOINT=output/pipeline_checkpoint.json

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_PATH=output/pipeline.log
NEO4J_BATCH_SIZE=5000
PARQUET_BATCH_SIZE=2000
CRAWL_RATE_LIMIT=1.5
CRAWL_TIMEOUT=15
CRAWL_MAX_RETRIES=3
CRAWL_CHECKPOINT=output/crawl_checkpoint.json
VECTOR_INDEX_NAME=article_embeddings

# ── Contract Parser ──────────────────────────────────────────────────────────
CONTRACT_PARSER_BACKEND=pipeline
CONTRACT_PARSER_LANG=ch
CONTRACT_MAX_FILE_SIZE_MB=10

# ── Frontend API Config ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=false
